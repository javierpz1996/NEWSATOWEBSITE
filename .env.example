# URL pública del sitio (opcional; en Vercel suele inferirse de VERCEL_URL).
# NEXT_PUBLIC_SITE_URL=https://satowebsite.vercel.app

# Supabase — propuestas del carrito (ADR-0006). Copiá a .env.local y completá.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor (nunca NEXT_PUBLIC). Dashboard → Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Clave para /sales, /new-work y /open-work. Si está vacío, el sitio usa 2020 por defecto.
SALES_ACCESS_TOKEN=2020
