# Supabase — propuestas del carrito (ADR-0006). Copiá a .env.local y completá.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor (nunca NEXT_PUBLIC). Dashboard → Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Clave para entrar a /sales (producción). Elegí una contraseña larga.
SALES_ACCESS_TOKEN=
